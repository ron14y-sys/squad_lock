# Copy to .env.local and fill in. .env* is gitignored — never commit a real key.

# Gemini API key. Create one at https://aistudio.google.com/apikey
# The free tier needs no billing account and no credit card.
GEMINI_API_KEY=

# The F2 spike route is reachable on the public deploy URL.
# Set to 1 only while measuring, then back to 0.
SPIKE_ENABLED=0
