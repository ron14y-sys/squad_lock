# Copy to .env and fill in real values locally. Never commit .env or
# .env.local — see docs/spec.md §10 ("secrets never enter the repo") and
# AGENTS.md. In deployment, every value below is set as a Vercel
# environment variable instead, never written to a file in the repo
# (spec §6.3: "All secrets ... live as Vercel environment variables, never
# in the repository").
#
# Six external services are required for MVP (spec §6.3) — this file has
# one entry per credential they need. A blank value here is expected until
# the track that owns that service provisions it; the point of this file is
# that the *name* of every variable is decided and documented from day one,
# so nobody has to guess or invent one later.

# --- Database (spec §6.3 #5) ---------------------------------------------
# Postgres connection string. Locally, e.g.:
# postgresql://squadlock:squadlock_dev@localhost:5432/squadlock_dev
#
# Needed by migrate, studio and introspect only. `npm install`, `npm run
# build` and the whole test suite work without it, because generating the
# Prisma client reads a schema file and opens no connection — see AGENTS.md,
# "The Prisma client is generated, never committed".
DATABASE_URL=

# --- Gemini API (spec §6.3 #3, §6.4) ---------------------------------------
# Matching agent + flash-class extraction (Constraint Updater, Context
# Resolver). Provisioned in A1.
#
# ⚠️ THERE ARE TWO FRONT DOORS TO THE SAME MODELS, and which one you are
# behind decides who pays. Set EITHER the key below OR the Cloud project
# further down; the client picks by whether GOOGLE_CLOUD_PROJECT is set.
#
#   |          | Gemini Developer API      | Vertex AI                     |
#   | console  | AI Studio                 | Google Cloud                  |
#   | auth     | the API key below         | gcloud ADC / service account  |
#   | billing  | its own prepay balance    | the project's Cloud billing   |
#
# Create a key at https://aistudio.google.com/apikey — the free tier needs no
# billing account. Note the free tier's daily cap and its data-use terms
# (spec §6.4, §13 item 17): both point at the paid tier before real user data
# flows through it.
#
# ⚠️ AND THE TRAP THAT COST US A DAY, 2026-09-27. Attaching *any* billing
# account to an AI Studio project takes it off the free tier and onto
# "Paid 1", where every call is drawn from a prepay credit balance. Google
# Cloud free-trial credits are NOT eligible for that balance — the billing
# page says so itself, "₪0 eligible GCP credits", while Cloud showed ₪891 of
# trial credit sitting unused. The result is 402 Payment Required on every
# call, from a project with plenty of money in it. Signing up for the Cloud
# free trial is enough to trigger this, because the trial creates the billing
# account. Vertex bills the Cloud account those credits live in, so it is the
# way back in without buying anything.
GEMINI_API_KEY=

# Model per task, and Gemini's effort dial with it (spec §6.4). Both optional —
# the defaults below are what the code uses when the variable is unset, and they
# are the mapping spec §6.4 records. They are variables rather than constants
# because A10 is an experiment ("can the lite model hold six profiles without
# dropping one?"), and an experiment that needs a commit to change one value is
# an experiment nobody runs twice.
#
# Any model name is accepted — Google decides what exists, and a list of ours
# would block new models and wave through retired ones. A model missing from
# PRICING in lib/llm/cost.ts still runs; it costs one log line saying its price
# is unknown, and A5 refuses to publish a cost figure until it is filled in.
# Thinking levels: minimal | low | medium | high, and anything else Google adds.
#
# ⚠️ Thinking is spent from the same output budget as the answer and dwarfs it,
# so raising these raises latency far more than it raises quality — F2 measured
# 4.7s at lite/low against 207.8s at gemini-3.6-flash/high, for the same input.
#
# GEMINI_MATCHING_MODEL=gemini-3.5-flash-lite
# GEMINI_MATCHING_THINKING=low
# GEMINI_EXTRACTION_MODEL=gemini-3.5-flash-lite
# GEMINI_EXTRACTION_THINKING=low

# --- Google Calendar OAuth (spec §5.2, §6.3 #1) ----------------------------
# Per-user OAuth consent, scope calendar.freebusy ONLY — never
# calendar.readonly, calendar.events, or any gmail.* scope (spec §6.3,
# "Rejected: the Gmail API"). Client ID and OAuth secret from the Google
# Cloud Console, one project for the whole app (spec §6.3, "One Google
# Cloud project"). Provisioned in B2.
#
# Named GOOGLE_OAUTH_SECRET rather than the more conventional Google-docs
# name for this value — deliberately: this repo's own leak check (this
# task's Verify line) greps history for a common OAuth-secret field name,
# so a variable *name* matching it would trip that check on every future
# run, forever, even though a name is not a value. Whatever you name a new
# secret here, check it against that grep before committing.
GOOGLE_CLIENT_ID=
GOOGLE_OAUTH_SECRET=

# Auth.js v5's own signing key — not one of the six external services, but
# required by NextAuth itself (it signs and encrypts the session JWT) and
# missing from this file until now, which is exactly the class of
# gap this file exists to prevent: the app ran locally without it (`next
# dev` mints a throwaway one with a console warning) and broke silently in
# every deployed environment, because Auth.js treats it as required, not
# optional, once NODE_ENV=production. Generate one with `npx auth secret`
# and set the same command's output as this variable in every environment —
# local .env AND every Vercel environment (Production, Preview, Development)
# each need their own value set there; nothing here is inherited from
# reading this file.
AUTH_SECRET=

# --- Vertex AI, the other door to the same models --------------------------
# Set GOOGLE_CLOUD_PROJECT and the client talks to Vertex instead of AI
# Studio, billing the Cloud project rather than an AI Studio prepay balance.
# Leave it unset and nothing changes — a teammate on an API key is unaffected.
#
# There is no key. Authentication is Application Default Credentials, which
# are two separate things and both are required:
#
#   1. the project is ALLOWED to use Vertex — enable "Vertex AI API"
#      (aiplatform.googleapis.com) once, in the Cloud console
#   2. this MACHINE is allowed to act as you:
#        gcloud auth application-default login
#        gcloud auth application-default set-quota-project <project-id>
#
# An API key covered both at once; Vertex separates them. Revoke the second
# with `gcloud auth application-default revoke`.
#
# ⚠️ Deployment needs a third thing that does not exist yet: Vercel has no
# ADC, so it needs a service account key. Until that is set up, production
# stays on GEMINI_API_KEY — which is the other reason both doors are open.
#
# The project ID, not the display name: "squad-lock" in the console is
# `squad-lock-506409` here. `gcloud projects list` prints both.
GOOGLE_CLOUD_PROJECT=

# Where Vertex serves the models, and `global` is not a placeholder — it is
# the answer. Both of this project's models return 404 in `us-central1`,
# which is the usual first guess. Measured 2026-09-27, not assumed.
# Optional: unset means `global`.
# GOOGLE_CLOUD_LOCATION=global

# --- Google Places API (New) (spec §5.4, §6.3 #2) --------------------------
# Project-level API key (not per-user OAuth) for Text Search (New). Every
# request must carry an explicit field mask — see spec §6.3, "The field
# mask is an architectural decision, not a parameter". Provisioned in B7.
#
# ⚠️ ONE ALLOWANCE FOR ALL OF US — so all of us limit what we spend of it.
# The free allowance is per SKU tier per Google Cloud *project*, not per key
# and not per person. Issuing yourself a separate key in the same project
# changes nothing about the budget; it only makes one key revocable on its
# own. The binding tier is Enterprise, at 1,000 requests a month between us:
#
#   searchNeighbourhood  id, displayName, formattedAddress,
#                        location, businessStatus          Pro         5,000/mo
#   fetchPlaceDetails    rating, regularOpeningHours        ENTERPRISE  1,000/mo
#                        ^ one call per shortlisted place
#
# SHORTLIST_SIZE is 24, so a single uncached matching run can spend 24 of
# those 1,000. That is roughly forty runs a month for the whole team — the
# kind of ceiling you reach by accident in an afternoon of debugging, not by
# using the product. Three rules keep it away:
#
#   1. Call searchNeighbourhoodCached / fetchPlaceDetailsCached from
#      lib/db/places-cache.ts — never the raw client in lib/places/client.ts.
#      The caches (30 days for a search, 24 hours for details) are what make
#      a repeated run cost nothing.
#   2. Develop and test against fixture candidates. No test and no eval may
#      reach the Places network; a suite that spends quota is a suite nobody
#      can afford to run twice.
#   3. Touch the real key deliberately — one run, at the end of a change,
#      and say in the PR how many calls it cost.
GOOGLE_PLACES_API_KEY=

# --- Transactional email (spec §5.5, §6.3 #4) ------------------------------
# Resend is the leading candidate, not a final decision (spec §13.8) — if
# the provider changes, rename this variable to match and update this
# comment. Backend-held API key, application-owned sender, no Gmail OAuth.
# Provisioned in B8, blocked on B12 (verified sending domain).
RESEND_API_KEY=

# --- The F2 spike ----------------------------------------------------------
# The runtime measurement in docs/decisions/runtime-budget.md is reachable on
# the public deploy URL and spends daily quota on every call. Set to 1 only
# while measuring, then back to 0.
SPIKE_ENABLED=0
