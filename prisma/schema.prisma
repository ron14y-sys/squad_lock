// SquadLock — database schema (spec §6.2)
//
// Source of truth: docs/spec.md §6.2. This file exists before any other
// track's code, per tasks/plan.md Week 1 — everything else builds on it.
//
// Prisma ORM 7: Rust-free client, driver adapter required (@prisma/adapter-pg),
// connection info lives in prisma.config.ts, not here.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

/// A person. Identity and Google tokens only — preferences live in
/// PreferenceProfile (spec §6.2).
model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String
  googleId           String   @unique
  googleRefreshToken String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  preferenceProfile   PreferenceProfile?
  groupMemberships    GroupMember[]
  initiatedMeetings   Meeting[]                   @relation("MeetingInitiator")
  responses           Response[]
  participantContexts ParticipantMeetingContext[]
  conflictDismissals  ConflictDismissal[]
  sentInvitations     Invitation[]                @relation("InvitationSender")
  acceptedInvitations Invitation[]                @relation("InvitationAcceptor")
  notifications       Notification[]

  @@map("users")
}

/// Hard constraints + soft preferences per user (spec §5.1). One row per
/// user. Constraint/preference *shapes* are still being iterated on by the
/// preference-game and hard-constraints screens, so they are stored as JSON
/// rather than fixed columns — narrowing them to real columns is a later,
/// cheap migration; guessing the shape wrong now is not.
model PreferenceProfile {
  id     String @id @default(cuid())
  userId String @unique

  /// Kosher, allergies, fixed unavailable hours — enforced in code, never
  /// left to the model (spec §4.1b).
  hardConstraints Json @default("{}")

  /// Cuisine, budget, atmosphere, noise level — soft signal only.
  softPreferences Json @default("{}")

  /// Home location at neighbourhood granularity, never a street address
  /// (spec §5.4) — this is also what keeps the venue cache shareable.
  homeLat           Float?
  homeLng           Float?
  homeNeighbourhood String?

  /// Travel tolerance in kilometres — stored as km, presented as a labelled
  /// slider (spec §5.1). Per-time-slot tolerance is layered on top of this
  /// baseline by the Context Resolver at match time; this is the default.
  toleranceKm Float @default(5)

  /// "No car on Fridays", "Tuesdays I come from work" — recurring, distinct
  /// from fixed unavailable hours: these affect distance, not availability
  /// (spec §5.1).
  recurringMobilityRules Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("preference_profiles")
}

// ---------------------------------------------------------------------------
// Groups
// ---------------------------------------------------------------------------

/// A group of 3–6 friends (spec §1.2, §5.3).
model Group {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     GroupMember[]
  meetings    Meeting[]
  invitations Invitation[]

  @@map("groups")
}

/// Resolves the many-to-many between User and Group — a user belongs to
/// several groups at once, and a group has several members (spec §1.2).
model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

/// An invitation to join a Group, by email (spec §5.3, §12.1) — the only
/// way anyone joins a group at all. Deliberately keyed on `email`, not
/// `userId`: per the spec's own success criteria, the invitee's *first*
/// contact with the app is this email, so they do not have a User row yet
/// when it is sent. Accepting it (after they sign in — B2) is what creates
/// their GroupMember row; nothing here does that automatically.
///
/// `token` is what the emailed link carries, so accepting works without
/// requiring the invitee to already be signed in with a session that knows
/// the group id. The actual *send* — the transactional email itself — is
/// B8's job, not this model's; a row here can exist and be accepted whether
/// or not that email ever went out (spec §5.5, D16's same principle applied
/// one step earlier).
///
/// `email` is stored as the caller supplies it; normalising it
/// (trim + lowercase) before every write and lookup is the API layer's job,
/// same as `User.email`.
model Invitation {
  id      String @id @default(cuid())
  groupId String
  email   String

  invitedById String
  status      InvitationStatus @default(pending)
  /// Unguessable by construction (a v4 UUID), not because anything hashes it.
  token       String           @unique @default(uuid())

  /// Set only once status flips to `accepted`.
  acceptedByUserId String?
  respondedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group            Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitedBy        User              @relation("InvitationSender", fields: [invitedById], references: [id])
  acceptedBy       User?             @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id])
  notificationLogs NotificationLog[]

  /// One live invitation per (group, email) at a time — inviting the same
  /// address twice re-sends, it does not duplicate. Also means an email that
  /// left the group can't be re-invited without first clearing the old row;
  /// not a case the spec calls out, so not solved ahead of being needed.
  @@unique([groupId, email])
  @@index([email])
  @@map("invitations")
}

enum InvitationStatus {
  pending
  accepted
}

// ---------------------------------------------------------------------------
// Meetings
// ---------------------------------------------------------------------------

enum MeetingStatus {
  weighing
  awaiting
  closed
  stuck
  cancelled
}

/// One get-together from initiation to close (spec §6.2). `conflicting` is
/// deliberately not a stored status — it is derived at read time from
/// ConflictDismissal + the cross-group query (spec §5.6).
model Meeting {
  id          String        @id @default(cuid())
  groupId     String
  initiatorId String
  status      MeetingStatus @default(weighing)
  cycleCount  Int           @default(0)

  /// Optionally pinned at initiation — the all-blank case is the default
  /// path, not a degraded one (spec §3, §5.3).
  pinnedDate  DateTime? @db.Date
  pinnedTime  String?
  pinnedVenue String?

  /// Free text set at initiation; an input to the Context Resolver (spec §6.2).
  occasion String?

  /// Denormalized from the current MatchRun's rank-1 MatchOption (or the
  /// pinned date/time, if given). Not in spec §6.2 verbatim — added so the
  /// feed can sort by date and the conflict query can scan "open meetings
  /// at time T" without joining through MatchRun/MatchOption on every read.
  /// Kept in sync by the application whenever a new top option is chosen.
  currentDatetime DateTime?

  /// Where the run weighing this meeting is right now (#155), so the screens
  /// that already poll can show progress (spec §12.6). Set by `runCycle` as it
  /// enters each stage and cleared when the run ends, however it ends. NULL is
  /// "no run in progress". A run killed mid-stage leaves its stage behind
  /// until the retry overwrites it, so readers show it only while `status` is
  /// `weighing` (`runStageOf`).
  runStage RunStage?

  /// B9 part two -- when set, no automatic retry is attempted before this
  /// instant, overriding the flat `RUN_ATTEMPT_COOLDOWN_MS`. Set by
  /// `runCycle`'s fault branch after a rate-limited Gemini call (a daily
  /// quota wall, not a blip -- retrying it every 90 seconds wastes polls
  /// for no reason); cleared back to null by any call that gets past that
  /// branch, whether it fails differently or succeeds outright. NULL is
  /// "nothing special", same as every meeting has today.
  retryNotBefore DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  initiator User  @relation("MeetingInitiator", fields: [initiatorId], references: [id])

  matchRuns           MatchRun[]
  responses           Response[]
  participantContexts ParticipantMeetingContext[]
  dismissalsAsA       ConflictDismissal[]         @relation("MeetingA")
  dismissalsAsB       ConflictDismissal[]         @relation("MeetingB")
  notificationLogs    NotificationLog[]
  notifications       Notification[]

  @@index([groupId])
  @@index([status, currentDatetime])
  @@map("meetings")
}

/// The stages of one run, in the order `runCycle` enters them (#155).
enum RunStage {
  calendars
  places
  venue_details
  model
  saving
}

/// One weighing cycle of a meeting (spec §6.2, §4.1d — every run persisted
/// in full).
model MatchRun {
  id          String @id @default(cuid())
  meetingId   String
  cycleNumber Int

  /// The shortlist that went in — candidate venues with their per-participant
  /// distances and viable time slots (spec §5.4).
  shortlist Json

  /// What this run cost, recorded because a log line cannot be totalled later
  /// (A4; docs/decisions/llm-client.md said these columns belong with whatever
  /// creates a run). A5 reports cost per scenario from them and §6.4 wants a
  /// cost-per-decision figure for the report — both read the number back, so
  /// it has to be stored and not merely printed.
  ///
  /// All nullable together: a run that failed before the call has none of
  /// them, and `costUsd` is null — never 0 — for a model missing from the
  /// price table, because a blank averaged into a total as a real measurement
  /// is worse than no figure at all (lib/llm/cost.ts, `CostBasis`).
  model         String?
  thinkingLevel String?
  durationMs    Int?
  inputTokens   Int?
  outputTokens  Int?
  thoughtTokens Int?
  cachedTokens  Int?
  costUsd       Decimal? @db.Decimal(12, 8)
  /// "exact" | "approximate" | "unknown" — how far to trust `costUsd`.
  costBasis     String?

  createdAt DateTime @default(now())

  meeting Meeting       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  options MatchOption[]

  /// Which ParticipantMeetingContext rows this run saw — so the timeline can
  /// say *why* a re-weighing happened (spec §6.2, §3.2).
  seenContexts MatchRunSeenContext[]

  @@unique([meetingId, cycleNumber])
  @@index([meetingId])
  @@map("match_runs")
}

/// One of the ranked options a run produced (spec §6.2, §4.1c). Only rank 1
/// is ever shown to the user; 2 and 3 are persisted for the timeline, the
/// eval set, and the report.
model MatchOption {
  id         String @id @default(cuid())
  matchRunId String
  rank       Int

  /// Venue snapshot at decision time (Places data can change later).
  venuePlaceId String?
  venueName    String
  venueAddress String?
  venueLat     Float?
  venueLng     Float?
  /// What the place is and a line about it, as Google put it (#163). Shown
  /// on the proposal; NULL when Google did not say.
  venueType    String?
  venueSummary String?

  proposedDatetime DateTime
  /// When it ends. Stored rather than implied: B6 shortens a meeting to fit a
  /// venue's opening hours, and "until midnight" is then the answer, not a
  /// detail (eval scenario 07 asserts it).
  proposedEnd      DateTime

  /// userId -> justification text, written for that viewer specifically
  /// (spec §5.6).
  participantJustifications Json

  /// What this option trades away, and for whom — persisted for the
  /// timeline and the report, but never rendered as a comparative cost line
  /// to the person who bore it (spec §5.6, §4.1c).
  tradeoffs Json

  /// What A2 could not check about this (venue, slot) — an UnverifiedFact[],
  /// e.g. `[{"kind":"opening_hours"}]`. Empty when everything was verified.
  ///
  /// The counterpart of `tradeoffs`, and its opposite in every way: this one
  /// IS shown, to everybody, with the asterisk docs/decisions/hard-constraints.md
  /// requires. Written by code from A2's findings, never by the model — a fact
  /// about a venue is code's to state (spec §4.4).
  ///
  /// **The structured fact, not the sentence.** The app is `lang="he"
  /// dir="rtl"`, and lib/format/hebrew-labels.ts is where a stored English
  /// literal becomes Hebrew at render time. Freezing the rendered sentence
  /// here would have made every historical row a translation problem.
  unverified Json @default("[]")

  createdAt DateTime @default(now())

  matchRun MatchRun @relation(fields: [matchRunId], references: [id], onDelete: Cascade)

  @@unique([matchRunId, rank])
  @@map("match_options")
}

/// Per-user, per-meeting response (spec §6.2, §3.2). A row exists for every
/// group member from the moment the meeting is created — defaulting to
/// `pending` — not created lazily when someone responds. This is what keeps
/// a dropped-out member listed instead of disappearing (spec §5.6), and it
/// is the join that makes "every open meeting for user X" an indexed lookup
/// instead of a scan (spec §5.7): index on (userId), join to Meeting by its
/// primary key.
model Response {
  id        String @id @default(cuid())
  meetingId String
  userId    String

  status      ResponseStatus @default(pending)
  reasonText  String?
  respondedAt DateTime?

  /// What A7 made of `reasonText`, or why it made nothing of it. NULL means
  /// no extraction was attempted — every response except `doesnt_suit`.
  extractionOutcome ExtractionOutcome?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([userId])
  @@map("responses")
}

enum ResponseStatus {
  pending
  approved
  cant_make_it
  doesnt_suit
}

/// The outcome of one Constraint Updater call (A7).
///
/// One enum for both axes, because they are mutually exclusive: either a
/// constraint was extracted — and the first five values say what kind of
/// objection it was — or it was not, and one of the last three says why.
///
/// `distance` and `time` are recorded rather than corrected: they are the
/// Context Resolver's material (A12), not a soft preference, and forcing one
/// into a soft field would be an invented opinion (issue #86).
///
/// The three failures are A1's own taxonomy, because each has a different
/// fix: `failed_quota` is the free tier's allowance, a routine outcome rather
/// than a fault; `failed_call` is a call that never came back; and
/// `failed_invalid` is an answer that came back unusable — truncated, or
/// rejected by validation.
enum ExtractionOutcome {
  soft
  distance
  time
  venue_identity
  none
  failed_quota
  failed_call
  failed_invalid
}

/// Sparse per-meeting correction — "no car tonight", "coming from work"
/// (spec §6.2, §3.2, §5.7). A row exists only when someone amends, and each
/// amendment appends a new row rather than overwriting the last one, so the
/// timeline can show which amendment triggered which re-weighing (spec §5.6).
model ParticipantMeetingContext {
  id        String @id @default(cuid())
  meetingId String
  userId    String

  /// Origin override for this one meeting, if the person isn't starting
  /// from home tonight.
  originLat   Float?
  originLng   Float?
  originLabel String?

  /// Mode-tagged windows, e.g. "no car between 18:00 and 21:00"
  /// (spec §6.2: mode is car / transit / walk).
  mobilityWindows Json @default("[]")

  /// A soft preference that applies to this meeting only — where a rejection
  /// lands (A7, spec §3.2, issue #86). "Too expensive this time" does not
  /// make somebody permanently thrifty, so the Constraint Updater writes a
  /// correction here rather than editing the profile.
  ///
  /// Nullable with no default, deliberately: NULL is "no correction", which
  /// is what every amendment row carries, while {} would mean "corrected to
  /// nothing" — a state nobody can be in.
  softPreferences Json?

  /// The rejection in the person's own words, and what A7 made of it (A8).
  ///
  /// Here rather than only on `Response` because a Response row is *updated*:
  /// one row per (meeting, user), so a second rejection overwrites the first
  /// and "no Asian food" is gone the moment the same person writes "no
  /// Italian either". Neither sentence has a SoftPreferences field to land
  /// in, so nothing else remembers them — and both the next proposal and the
  /// timeline are left with one sentence per person forever. These rows
  /// append, so the history keeps itself.
  ///
  /// `rejectionOutcome` duplicates `Response.extractionOutcome` for the
  /// latest rejection and diverges for every earlier one, which is the point:
  /// a Response row is that person's *current* state, and this is the record
  /// of one objection. Blocking what was rejected needs the objection that
  /// was raised at the time, round by round.
  ///
  /// Both NULL together on an amendment row — which is also how the free
  /// amendment is counted (see `respondToMeeting`).
  rejectionText    String?
  rejectionOutcome ExtractionOutcome?

  /// This meeting only (#220): how far this person will travel, and the
  /// earliest / latest local start (`HH:MM`) they accept. Set by A7 from a
  /// rejection or by an amendment; NULL is "the profile's", and "no bound".
  toleranceKm   Float?
  earliestStart String?
  latestStart   String?
  /// What a rejection asked for that no lever can act on, in A7's words —
  /// kept so the missing levers can be counted (#220).
  untranslated  String?

  note String?

  createdAt DateTime @default(now())

  meeting    Meeting               @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  seenByRuns MatchRunSeenContext[]

  @@index([meetingId, userId, createdAt])
  @@map("participant_meeting_contexts")
}

/// Join table recording which ParticipantMeetingContext rows a given
/// MatchRun saw (spec §6.2: "Each MatchRun records which rows it saw").
model MatchRunSeenContext {
  matchRunId String
  contextId  String

  matchRun MatchRun                  @relation(fields: [matchRunId], references: [id], onDelete: Cascade)
  context  ParticipantMeetingContext @relation(fields: [contextId], references: [id], onDelete: Cascade)

  @@id([matchRunId, contextId])
  @@map("match_run_seen_contexts")
}

/// Per user and unordered meeting pair: this user has said the two do not
/// clash (spec §6.2, §5.7). Postgres unique constraints are ordered, so the
/// canonical order — meetingAId < meetingBId, compared as strings — is
/// enforced by the application before every insert and lookup; see
/// lib/db/conflict-dismissal.ts.
model ConflictDismissal {
  id         String   @id @default(cuid())
  userId     String
  meetingAId String
  meetingBId String
  createdAt  DateTime @default(now())

  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  meetingA Meeting @relation("MeetingA", fields: [meetingAId], references: [id], onDelete: Cascade)
  meetingB Meeting @relation("MeetingB", fields: [meetingBId], references: [id], onDelete: Cascade)

  @@unique([userId, meetingAId, meetingBId])
  @@map("conflict_dismissals")
}

/// B7 two-tier Places cache, tier 1 (spec §6.3): the broad Nearby Search
/// (New) result for one neighbourhood-sized area — a property of a
/// *location*, not of any one meeting, so it is keyed on coordinates rather
/// than on a meeting id and shared across every meeting and user that
/// searches nearby. `results` holds `Candidate[]` from
/// `lib/places/client.ts`'s `searchNeighbourhood` — Essentials+Pro fields
/// only, `rating`/`openingHours` always absent here (they are tier 2).
/// See lib/db/places-cache.ts for the rounding and freshness rules.
model PlaceSearchCache {
  id            String   @id @default(cuid())
  /// Rounded to neighbourhood granularity by `roundToNeighbourhood` —
  /// already-equal inputs are required to produce bit-identical keys for
  /// the unique constraint below to ever hit.
  latKey        Float
  lngKey        Float
  radiusMeters  Int
  /// #168: the Nearby Search `includedTypes` list, sorted and comma-joined
  /// (e.g. "bar,cafe,restaurant") — part of the key so a morning search
  /// (cafés only) is never served an evening's cached restaurants-and-bars
  /// answer for the same coordinates and radius.
  includedTypes String
  results       Json
  fetchedAt     DateTime @default(now())

  @@unique([latKey, lngKey, radiusMeters, includedTypes])
  @@map("place_search_cache")
}

/// B7 two-tier Places cache, tier 2 (spec §6.3): the Enterprise-tier detail
/// fields — `rating`, `regularOpeningHours` — for one shortlisted place.
/// Cached **separately and more briefly** than tier 1 on purpose: opening
/// hours change for holidays and closures, and this is the data that
/// decides whether a proposal is real. Keyed on `placeId` directly, no
/// rounding — a Places id is already exact and stable.
model PlaceDetailsCache {
  placeId              String   @id
  rating               Float?
  /// `LocalWindow[]`, same shape `Candidate.openingHours` and
  /// `trimPairToViableSlots` already consume. `[]` means "fetched, no
  /// hours returned" — distinct from the row not existing at all, which
  /// means "never fetched."
  openingHours         Json     @default("[]")
  /// `modest` or `splurge`, from `priceLevel` (#139). NULL is "not known" —
  /// no price returned, or `PRICE_LEVEL_MODERATE`, which fits neither answer.
  budget               String?
  /// Google's `editorialSummary` (#163). NULL when Google has none, which
  /// for Israeli venues is often.
  summary              String?
  /// Google's `servesVegetarianFood`. NULL is "not known" — Google did not
  /// say, or the row predates the field.
  servesVegetarianFood Boolean?
  fetchedAt            DateTime @default(now())

  @@map("place_details_cache")
}

/// B8 — a record of every transactional-email attempt (spec §5.5's binding
/// rule: "the failure is recorded against the notification, retried, and
/// surfaced as a notification problem, not as a scheduling one"). This is
/// what makes that true in the database, not just in the code's intent: a
/// failed send is a row here, never a reason a Meeting or Invitation write
/// rolled back — every `notify*` call in `lib/email/notify.ts` runs only
/// after the state change it is about has already committed.
///
/// Deliberately not the retry mechanism itself (B9, still unscoped) — just
/// the record a retry mechanism, or a person reading the table, would need.
/// One attempt is logged per send today; nothing here re-sends on its own.
///
/// `meetingId` and `invitationId` are both nullable and independent: a
/// notification is about at most one of them — an invitation email has no
/// meeting, every meeting-state email has no invitation — never both and
/// never neither.
model NotificationLog {
  id                String             @id @default(cuid())
  kind              NotificationKind
  /// Denormalized, not a User relation — the address this attempt actually
  /// used, so a later email change on the account doesn't rewrite history
  /// (same reasoning as MatchOption's venue snapshot).
  recipientEmail    String
  status            NotificationStatus
  /// Resend's own id for a sent message — nothing reads this back yet, but
  /// it is what you would paste into their dashboard to find this send.
  providerMessageId String?
  errorMessage      String?

  meetingId    String?
  invitationId String?

  /// B9 part one -- how many times this logical notification has been
  /// attempted, counting this row. The first send is 1; a retry writes a
  /// *new* row with `attempt` one higher than the row it retried. Never
  /// mutated -- this stays an append-only log, same as `MatchRun`.
  attempt   Int       @default(1)
  /// B9 part one -- set once this failed row has been claimed for a retry
  /// (whether or not the retry itself succeeds). The optimistic lock
  /// `retryDueNotifications` uses so two concurrent polls cannot both
  /// retry the same failure -- same trick as `runDueMeetings`'s claim on
  /// `Meeting.updatedAt`, aimed at this column instead. Always `null` on a
  /// `sent` row.
  retriedAt DateTime?

  createdAt DateTime @default(now())

  meeting    Meeting?    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  invitation Invitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([invitationId])
  @@index([status, retriedAt])
  @@map("notification_log")
}

/// C9 — the "in-app" half of spec §5.5's "v1 notifications are in-app +
/// email." One row per recipient per trigger, written alongside (never
/// instead of) the `NotificationLog` row `lib/email/notify.ts` already
/// creates for the same event.
///
/// Deliberately a separate table from `NotificationLog`, not an added
/// column on it: that table is a delivery log keyed on `recipientEmail`,
/// with no per-user read state and no guarantee a `User` row exists yet —
/// an invitation can be sent to someone who has never signed up (see that
/// model's own comment). This table exists only for the four triggers
/// where a `User` definitely does: `invitation` is a valid NotificationKind
/// here too (one enum, not two) but is never actually written to this
/// table — there is nobody signed in yet to show it to.
model Notification {
  id     String           @id @default(cuid())
  userId String
  kind   NotificationKind

  /// Always set in practice (every kind this table is written for is
  /// meeting-related) — nullable only because the shared enum still
  /// includes `invitation`, which has none.
  meetingId String?

  /// NULL means unread. A timestamp rather than a boolean for the same
  /// reason `Response.respondedAt` is one — "whether" and "when" are both
  /// worth keeping, and a boolean would have to throw one away.
  readAt DateTime?

  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  meeting Meeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  /// The one query this table exists to answer: this user's, unread first.
  @@index([userId, readAt])
  @@map("notifications")
}

/// The five spec §5.5 triggers. Only `proposal_waiting` is wired to a
/// sender yet (B8 part one) — the other four are declared here because
/// they are the fixed, spec-mandated list, not a guess, and B8 part two
/// wires them to the hook points `tasks/todo.md` already names.
enum NotificationKind {
  invitation
  proposal_waiting
  meeting_confirmed
  conflict_reweigh
  stuck
  /// B10 -- a participant's Google refresh token was rejected
  /// (CalendarAuthError). Addressed to the User directly, not a meeting or
  /// invitation -- the broken connection affects every meeting they are in,
  /// not just the one that happened to surface it -- so both refs stay null.
  calendar_reconnect
}

enum NotificationStatus {
  sent
  failed
}
